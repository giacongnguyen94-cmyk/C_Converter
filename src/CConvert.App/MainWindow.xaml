<Window x:Class="CConvert.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C_Converter – Hạ phiên bản CorelDRAW" Height="760" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave"
        Icon="Assets/app.ico" FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <DockPanel>
        <!-- ===== Thanh tiêu đề ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,2">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="Bold">
                        <Run Text="C_" Foreground="{StaticResource Accent}"/><Run Text="Converter"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource TextMuted}" Margin="1,2,0,0"
                               Text="Hạ phiên bản CorelDRAW 2020 – 2024 (2025 · 2026 thử nghiệm) xuống 2019 · không cần cài CorelDRAW"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                        CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock Text="v1.0" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Thiết lập + chạy (dưới cùng) ===== -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="20,0,20,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="PHIÊN BẢN ĐÍCH" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="TargetBox" Width="210" SelectedIndex="0"/>
                    <TextBlock Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="Nguồn: 2020 · 2021 · 2022 · 2023 · 2024"/>
                    <Border Background="#262FA8FF" BorderBrush="{StaticResource Info}" BorderThickness="1" CornerRadius="10"
                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                            ToolTip="Chưa có mẫu 2025/2026 để kiểm chứng: dùng chung quy tắc 2020–2024, lọc theo lược đồ 2019, dừng nếu gặp bản ghi lạ. Nên mở kiểm tra bằng CorelDRAW 2019.">
                        <TextBlock Text="2025 · 2026 thử nghiệm" Foreground="{StaticResource Info}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="LƯU KẾT QUẢ" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,12,16,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <RadioButton x:Name="BesideSource" Content="Cạnh file gốc (thêm đuôi _2019)" IsChecked="True" VerticalAlignment="Center"/>
                    <RadioButton x:Name="ToFolder" Content="Vào thư mục:" Margin="22,0,10,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="OutDirBox" Width="300" IsEnabled="{Binding IsChecked, ElementName=ToFolder}"/>
                    <Button Margin="8,0,0,0" Padding="10,6" Click="OnPickOutDir" IsEnabled="{Binding IsChecked, ElementName=ToFolder}" ToolTip="Chọn thư mục">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" Margin="0"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Click="OnStop" IsEnabled="False" Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;"/>
                            <TextBlock Text="Dừng"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="OnStart" Padding="26,10" Margin="0" FontSize="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;"/>
                            <TextBlock Text="Bắt đầu chuyển"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
                    <Button DockPanel.Dock="Right" Click="OnSaveLog" Margin="8,0,0,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;"/>
                            <TextBlock Text="Lưu nhật ký"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Click="OnOpenOutput" Margin="8,0,0,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xED25;"/>
                            <TextBlock Text="Mở thư mục kết quả"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,8,0"
                               Foreground="{StaticResource TextMuted}"/>
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ===== Nội dung ===== -->
        <Grid Margin="20,16,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Thanh lệnh + thống kê -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Button Click="OnAddFiles">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="Thêm file"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnAddFolder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="Thêm thư mục"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearButton" Click="OnClear">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;"/>
                            <TextBlock Text="Xóa danh sách"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" Margin="8,0,0,0">
                        <TextBlock><Run Text="Tổng " Foreground="{StaticResource TextMuted}"/><Run x:Name="StatTotal" Text="0" FontWeight="Bold"/></TextBlock>
                    </Border>
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" Margin="8,0,0,0">
                        <TextBlock><Run Text="Hoàn tất " Foreground="{StaticResource TextMuted}"/><Run x:Name="StatDone" Text="0" FontWeight="Bold" Foreground="{StaticResource Success}"/></TextBlock>
                    </Border>
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" Margin="8,0,0,0">
                        <TextBlock><Run Text="Cảnh báo " Foreground="{StaticResource TextMuted}"/><Run x:Name="StatWarn" Text="0" FontWeight="Bold" Foreground="{StaticResource Warning}"/></TextBlock>
                    </Border>
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" Margin="8,0,0,0">
                        <TextBlock><Run Text="Lỗi " Foreground="{StaticResource TextMuted}"/><Run x:Name="StatFail" Text="0" FontWeight="Bold" Foreground="{StaticResource Danger}"/></TextBlock>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Danh sách file -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionChanged="OnSelectionChanged" Margin="4">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="TÊN FILE" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PHIÊN BẢN GỐC" Binding="{Binding SourceVersion}" Width="1.4*"/>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Background="{Binding StatusBackground}">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CẢNH BÁO" Binding="{Binding WarningCount}" Width="90"/>
                            <DataGridTextColumn Header="KẾT QUẢ" Binding="{Binding OutputPath}" Width="3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding OutputPath}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Vùng kéo thả (hiện khi danh sách trống) -->
                    <Border x:Name="DropHint" Margin="24,56,24,24" CornerRadius="12" Background="#08FFC400" IsHitTestVisible="False">
                        <Grid>
                            <Rectangle x:Name="DropBorder" RadiusX="12" RadiusY="12" Stroke="{StaticResource Accent}" StrokeThickness="2"
                                       StrokeDashArray="6 4" Opacity="0.55"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Kéo thả file .cdr hoặc thư mục vào đây" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,14,0,4"/>
                                <TextBlock Text="hoặc bấm “Thêm file” / “Thêm thư mục” · thư mục con được quét tự động"
                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Nhật ký -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="LogTitle" Text="NHẬT KÝ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="chọn một file để xem riêng" Foreground="{StaticResource TextMuted}" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg}" Foreground="#D6D6DA" Padding="10,8"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
