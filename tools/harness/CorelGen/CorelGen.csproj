<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bộ tạo mẫu (chỉ dùng khi phát triển, KHÔNG phải phụ thuộc của C_Converter): điều khiển CorelDRAW 2026 qua COM. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <Reference Include="Interop.VGCore"><HintPath>lib\Interop.VGCore.dll</HintPath><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
  </ItemGroup>
</Project>
